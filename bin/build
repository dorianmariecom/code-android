#!/bin/bash

set -e

RELEASE_NOTES="$*"

if [ -z "$RELEASE_NOTES" ]; then
  echo "Usage: bin/build \"changelog\"" >&2
  exit 1
fi

RELEASE_NOTES="$RELEASE_NOTES" bin/fastlane android test
RELEASE_NOTES="$RELEASE_NOTES" bin/fastlane android localhost
RELEASE_NOTES="$RELEASE_NOTES" bin/fastlane android development
RELEASE_NOTES="$RELEASE_NOTES" bin/fastlane android staging
RELEASE_NOTES="$RELEASE_NOTES" bin/fastlane android production
