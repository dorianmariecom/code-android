default_platform(:android)

require "fileutils"
require "tmpdir"

def gradle_task_suffix(build_type)
  build_type[0].upcase + build_type[1..]
end

def build_aab(module_name, build_type)
  task = ":#{module_name}:bundle#{gradle_task_suffix(build_type)}"
  gradle(task: task)
  File.join(
    module_name,
    "build/outputs/bundle/#{build_type}/#{module_name}-#{build_type}.aab"
  )
end

def version_code_for_module(module_name)
  gradle_file = File.join(module_name, "build.gradle.kts")
  content = File.read(gradle_file)
  match = content.match(/versionCode\s*=\s*(\d+)/)
  raise "Unable to find versionCode in #{gradle_file}" if match.nil?
  match[1]
end

def metadata_path_for_changelog(changelog, version_code:, locale: "en-US")
  return nil if changelog.to_s.strip.empty?

  tmp_dir = Dir.mktmpdir("fastlane-metadata")
  changelog_dir = File.join(tmp_dir, locale, "changelogs")
  FileUtils.mkdir_p(changelog_dir)
  File.write(File.join(changelog_dir, "#{version_code}.txt"), changelog)
  tmp_dir
end

def upload_to_play(
  package_name,
  aab_path,
  track,
  release_status,
  module_name: nil,
  changelog: nil
)
  version_code = nil
  if !changelog.to_s.strip.empty? && module_name
    version_code = version_code_for_module(module_name)
  end

  metadata_path =
    metadata_path_for_changelog(
      changelog,
      version_code: version_code
    ) if version_code

  supply(
    package_name: package_name,
    aab: aab_path,
    skip_upload_apk: true,
    track: track,
    release_status: release_status,
    json_key: ENV["PLAY_STORE_JSON_KEY"],
    metadata_path: metadata_path,
    skip_upload_metadata: metadata_path.nil?,
    skip_upload_changelogs: metadata_path.nil?,
    skip_upload_images: true,
    skip_upload_screenshots: true
  )
end

platform :android do
  desc "Upload test build to Google Play"
  lane :test do
    aab_path = build_aab("test", "ttest")
    upload_to_play(
      "com.codedorian.test",
      aab_path,
      ENV["PLAY_TRACK_TEST"] || "internal",
      "draft"
    )
  end

  desc "Upload localhost build to Google Play"
  lane :localhost do
    aab_path = build_aab("localhost", "localhost")
    upload_to_play(
      "com.codedorian.localhost",
      aab_path,
      ENV["PLAY_TRACK_LOCALHOST"] || "internal",
      "draft"
    )
  end

  desc "Upload development build to Google Play"
  lane :development do
    aab_path = build_aab("development", "development")
    upload_to_play(
      "com.codedorian.development",
      aab_path,
      ENV["PLAY_TRACK_DEVELOPMENT"] || "internal",
      "draft"
    )
  end

  desc "Upload staging build to Google Play"
  lane :staging do
    aab_path = build_aab("staging", "staging")
    upload_to_play(
      "com.codedorian.staging",
      aab_path,
      ENV["PLAY_TRACK_STAGING"] || "internal",
      "draft"
    )
  end

  desc "Upload production build to Google Play"
  lane :production do
    aab_path = build_aab("production", "production")
    upload_to_play(
      "com.codedorian",
      aab_path,
      ENV["PLAY_TRACK_PRODUCTION"] || "production",
      "completed",
      module_name: "production",
      changelog: ENV["RELEASE_NOTES"]
    )
  end
end
