default_platform(:android)

require "fileutils"
require "tmpdir"

def gradle_task_suffix(name)
  name[0].upcase + name[1..]
end

def build_aab(flavor_name, build_type = "release")
  variant_name = "#{flavor_name}#{gradle_task_suffix(build_type)}"
  task = ":app:bundle#{gradle_task_suffix(variant_name)}"
  gradle(task: task)
  File.join(
    "app",
    "build/outputs/bundle/#{variant_name}/app-#{flavor_name}-#{build_type}.aab"
  )
end

def version_code
  gradle_file = File.expand_path("../app/build.gradle.kts", __dir__)
  content = File.read(gradle_file)
  match = content.match(/versionCode\s*=\s*(\d+)/)
  raise "Unable to find versionCode in #{gradle_file}" if match.nil?
  match[1]
end

def metadata_path_for_changelogs(changelogs_by_locale, version_code:)
  valid_entries =
    changelogs_by_locale.to_h.select { |_, value| !value.to_s.strip.empty? }
  return nil if valid_entries.empty?

  tmp_dir = Dir.mktmpdir("fastlane-metadata")

  valid_entries.each do |locale, changelog|
    changelog_dir = File.join(tmp_dir, locale, "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{version_code}.txt"), changelog)
  end

  tmp_dir
end

def upload_to_play(
  package_name,
  aab_path,
  track,
  release_status,
  changelog: nil,
  changelogs_by_locale: nil
)
  version_code = nil
  effective_changelogs = changelogs_by_locale.to_h
  if effective_changelogs.empty? && !changelog.to_s.strip.empty?
    effective_changelogs = { "en-US" => changelog }
  end

  version_code = version_code() if !effective_changelogs.empty?

  metadata_path =
    metadata_path_for_changelogs(
      effective_changelogs,
      version_code: version_code
    ) if version_code

  supply(
    package_name: package_name,
    aab: aab_path,
    skip_upload_apk: true,
    track: track,
    release_status: release_status,
    json_key: ENV["PLAY_STORE_JSON_KEY"],
    metadata_path: metadata_path,
    skip_upload_metadata: metadata_path.nil?,
    skip_upload_changelogs: metadata_path.nil?,
    skip_upload_images: true,
    skip_upload_screenshots: true
  )
end

platform :android do
  desc "Upload test build to Google Play"
  lane :test do
    aab_path = build_aab("ttest")
    upload_to_play(
      "com.codedorian.test",
      aab_path,
      ENV["PLAY_TRACK_TEST"] || "internal",
      "draft"
    )
  end

  desc "Upload localhost build to Google Play"
  lane :localhost do
    aab_path = build_aab("localhost")
    upload_to_play(
      "com.codedorian.localhost",
      aab_path,
      ENV["PLAY_TRACK_LOCALHOST"] || "internal",
      "draft"
    )
  end

  desc "Upload development build to Google Play"
  lane :development do
    aab_path = build_aab("development")
    upload_to_play(
      "com.codedorian.development",
      aab_path,
      ENV["PLAY_TRACK_DEVELOPMENT"] || "internal",
      "draft"
    )
  end

  desc "Upload staging build to Google Play"
  lane :staging do
    aab_path = build_aab("staging")
    upload_to_play(
      "com.codedorian.staging",
      aab_path,
      ENV["PLAY_TRACK_STAGING"] || "internal",
      "draft"
    )
  end

  desc "Upload production build to Google Play"
  lane :production do
    aab_path = build_aab("production")
    upload_to_play(
      "com.codedorian",
      aab_path,
      ENV["PLAY_TRACK_PRODUCTION"] || "production",
      "completed",
      changelogs_by_locale: {
        "en-US" => (ENV["EN_CHANGELOG"] || ENV["RELEASE_NOTES"]),
        "fr-FR" => ENV["FR_CHANGELOG"]
      }
    )
  end
end
